@page "/manage/organizers"
@layout MainLayout
@inject BadmintonHub.Client.Services.UserSession Session
@inject BadmintonHub.Application.Common.Interfaces.IApplicationDbContext DbContext
@inject Microsoft.AspNetCore.Identity.UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IServiceProvider appServices

<PageTitle>Manage Organizers - Badminton Hub</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <div class="d-flex justify-space-between align-center mb-1">
        <MudText Typo="Typo.h4" Style="font-family: 'Outfit', sans-serif; font-weight: bold; color: #1c1e21;">
            Manage Organizers
        </MudText>

        @if (Session.CurrentUser?.Role == UserRole.SuperAdmin)
        {
            <MudButton Variant="Variant.Filled" 
                       Color="Color.Primary" 
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenAddOrganizerDialog"
                       Style="border-radius: 8px; text-transform: none; font-weight: bold; background-color: #1877F2;">
                Add Organizer
            </MudButton>
        }
    </div>
    
    <MudText Typo="Typo.body1" Class="mud-text-secondary mb-4">
        Administration interface to onboard, configure, suspend, and allocate credits to club tenants.
    </MudText>

    @if (_loading)
    {
        <div class="d-flex justify-content-center align-items-center pa-10">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        </div>
    }
    else
    {
        <MudGrid>
            <MudItem xs="12">
                <MudPaper Elevation="2" Style="border-radius: 12px;" Class="pa-4">
                    @if (_organizersList.Count == 0)
                    {
                        <div class="pa-10 text-center">
                            <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
                            <MudText Typo="Typo.h6" Class="mud-text-secondary">No Organizers Found</MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">Add a new club organizer to start event publishing.</MudText>
                        </div>
                    }
                    else
                    {
                        <MudTable Items="_organizersList" Hover="true" Striped="true">
                            <HeaderContent>
                                <MudTh>Organizer Name</MudTh>
                                <MudTh>Contact / Phone</MudTh>
                                <MudTh>Credits Remaining</MudTh>
                                <MudTh>Associated Account</MudTh>
                                <MudTh>Status</MudTh>
                                <MudTh>Actions</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Name"><strong>@context.Org.Name</strong></MudTd>
                                <MudTd DataLabel="Contact">@context.Org.ContactNumber</MudTd>
                                <MudTd DataLabel="Credits">
                                    <MudChip T="string" Color="Color.Warning" Size="Size.Small">
                                        @context.Org.CreditsRemaining Credits
                                    </MudChip>
                                </MudTd>
                                <MudTd DataLabel="Account">
                                    @if (context.User != null)
                                    {
                                        <span>@context.User.FullName (@context.User.UserName)</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger">No login account</span>
                                    }
                                </MudTd>
                                <MudTd DataLabel="Status">
                                    @if (context.User != null)
                                    {
                                        <MudChip T="string" Color="@(context.User.Status == UserStatus.Active ? Color.Success : context.User.Status == UserStatus.Suspended ? Color.Error : Color.Warning)" Size="Size.Small">
                                            @(context.User.Status == UserStatus.Suspended ? "Inactive" : context.User.Status.ToString())
                                        </MudChip>
                                    }
                                </MudTd>
                                <MudTd DataLabel="Actions">
                                    <MudMenu Label="Actions" EndIcon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                                        <MudMenuItem OnClick="() => OpenEditDialog(context)" Icon="@Icons.Material.Filled.Edit">Edit Organizer</MudMenuItem>
                                        <MudMenuItem OnClick="@(async () => await OpenAddCreditsDialog(context.Org, "Add"))" Icon="@Icons.Material.Filled.AddCircle">Add Credits</MudMenuItem>
                                        <MudMenuItem OnClick="@(async () => await OpenAddCreditsDialog(context.Org, "Reduce"))" Icon="@Icons.Material.Filled.RemoveCircle">Reduce Credits</MudMenuItem>
                                        
                                        @if (context.User != null)
                                        {
                                            @if (context.User.Status == UserStatus.Active)
                                            {
                                                <MudMenuItem OnClick="() => ToggleSuspend(context.User, true)" Icon="@Icons.Material.Filled.Block" Style="color: orange;">Inactive</MudMenuItem>
                                            }
                                            else
                                            {
                                                <MudMenuItem OnClick="() => ToggleSuspend(context.User, false)" Icon="@Icons.Material.Filled.CheckCircle" Style="color: green;">Activate</MudMenuItem>
                                            }
                                            <MudMenuItem OnClick="() => ResetPassword(context.User)" Icon="@Icons.Material.Filled.LockReset">Reset Password</MudMenuItem>
                                        }
                                        
                                        <MudMenuItem OnClick="() => ViewEvents(context.Org)" Icon="@Icons.Material.Filled.Event">View Events</MudMenuItem>
                                        
                                        <MudDivider />
                                        <MudMenuItem OnClick="() => DeleteOrganizer(context)" Icon="@Icons.Material.Filled.Delete" Style="color: red;">Delete Organizer</MudMenuItem>
                                    </MudMenu>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

<!-- ADD/EDIT ORGANIZER DIALOG -->
<MudDialog @bind-Visible="_organizerDialogVisible" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6" Class="font-weight-bold">@(_isEdit ? "Edit Organizer" : "Add Organizer")</MudText>
    </TitleContent>
    <DialogContent>
        <div class="d-flex flex-column gap-4 pa-2">
            <MudTextField @bind-Value="_editingOrg.Name" Label="Organizer Name" Required="true" Variant="Variant.Outlined" ShrinkLabel="true" />
            <MudTextField @bind-Value="_editingOrg.ContactNumber" Label="Contact / Mobile" Required="true" Variant="Variant.Outlined" ShrinkLabel="true" HelperText="This contact is used as the login mobile number" />
            @if (!_isEdit)
            {
                <MudNumericField @bind-Value="_editingOrg.CreditsRemaining" Label="Initial Event Credits" Min="1" Variant="Variant.Outlined" />
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="() => _organizerDialogVisible = false">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveOrganizer" Style="background-color: #1877F2; text-transform: none;">Save</MudButton>
    </DialogActions>
</MudDialog>

<!-- CREDENTIALS DISPLAY DIALOG -->
<MudDialog @bind-Visible="_credentialsVisible" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6" Class="font-weight-bold" Color="Color.Success">Account Created Successfully</MudText>
    </TitleContent>
    <DialogContent>
        <div class="d-flex flex-column gap-4 pa-2">
            <div>
                <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">Mobile:</MudText>
                <MudText Typo="Typo.h6" Class="font-weight-bold">@_createdMobile</MudText>
            </div>
            <div>
                <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">Temporary Password:</MudText>
                <MudText Typo="Typo.h6" Class="font-weight-bold" Style="font-family: monospace;">@_createdPassword</MudText>
            </div>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="CopyMobile" Style="text-transform: none;">Copy Mobile Number</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="CopyPassword" Style="text-transform: none;">Copy Password</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => _credentialsVisible = false">Close</MudButton>
    </DialogActions>
</MudDialog>

<!-- ADD CREDITS DIALOG -->
<MudDialog @bind-Visible="_addCreditsVisible" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6" Class="font-weight-bold">Manage Event Credits: @_selectedOrgForCredits?.Name</MudText>
    </TitleContent>
    <DialogContent>
        <div class="d-flex flex-column gap-4 pa-2">
            <div class="d-flex align-items-center justify-content-between">
                <MudText Typo="Typo.subtitle1">Current Balance:</MudText>
                <MudChip T="string" Color="Color.Warning" Size="Size.Small">@(_selectedOrgForCredits?.CreditsRemaining) Credits</MudChip>
            </div>
            
            <MudSelect T="string" @bind-Value="_creditsAction" Label="Action" Variant="Variant.Outlined">
                <MudSelectItem Value='string.Format("Add")'>Add / Grant Credits</MudSelectItem>
                <MudSelectItem Value='string.Format("Reduce")'>Reduce / Deduct Credits</MudSelectItem>
            </MudSelect>

            <MudNumericField @bind-Value="_creditsToAdd" Label="Credits Amount" Min="1" Required="true" Variant="Variant.Outlined" />
            <MudTextField @bind-Value="_creditsDescription" Label="Transaction Reference / Reason" Required="true" Variant="Variant.Outlined" />

            <MudDivider Class="my-4" />
            <MudText Typo="Typo.subtitle2" Class="font-weight-bold">Transaction History</MudText>
            <div style="max-height: 200px; overflow-y: auto;">
                @if (_creditHistory.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary text-center">No transaction history found.</MudText>
                }
                else
                {
                    <MudSimpleTable Dense="true" Hover="true">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Change</th>
                                <th>Reason</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var tx in _creditHistory)
                            {
                                <tr>
                                    <td>@tx.Timestamp.ToLocalTime().ToString("g")</td>
                                    <td>
                                        <span class="@(tx.CreditsChanged >= 0 ? "text-success" : "text-danger")">
                                            @(tx.CreditsChanged >= 0 ? $"+{tx.CreditsChanged}" : $"{tx.CreditsChanged}")
                                        </span>
                                    </td>
                                    <td>@tx.Description</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }
            </div>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="() => _addCreditsVisible = false">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveCreditsGrant" Style="background-color: #1877F2; text-transform: none;">Apply</MudButton>
    </DialogActions>
</MudDialog>

<!-- VIEW EVENTS DIALOG -->
<MudDialog @bind-Visible="_viewEventsVisible" Options="_eventsDialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6" Class="font-weight-bold">Events Created by: @_selectedOrgForEvents?.Name</MudText>
    </TitleContent>
    <DialogContent>
        <div class="pa-2" style="max-height: 400px; overflow-y: auto;">
            @if (_orgEvents.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary text-center pa-4">No events created by this organizer.</MudText>
            }
            else
            {
                <MudSimpleTable Hover="true" Striped="true">
                    <thead>
                        <tr>
                            <th>Event Name</th>
                            <th>Venue</th>
                            <th>Date</th>
                            <th>Fee</th>
                            <th>Capacity</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ev in _orgEvents)
                        {
                            <tr>
                                <td><strong>@ev.Name</strong></td>
                                <td>@ev.Venue</td>
                                <td>@ev.EventDate.ToShortDateString()</td>
                                <td>@ev.EventFee.ToString("C")</td>
                                <td>@ev.RegisteredPlayersCount / @ev.MaxPlayers</td>
                                <td><MudChip T="string" Color="@(ev.Status == EventStatus.Open ? Color.Success : Color.Error)" Size="Size.Small">@ev.Status</MudChip></td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => _viewEventsVisible = false" Style="background-color: #1877F2; text-transform: none;">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private bool _loading = true;
    private List<OrganizerVm> _organizersList = new();
    private DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true };
    private DialogOptions _eventsDialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true };

    private bool _organizerDialogVisible;
    private bool _isEdit;
    private Organizer _editingOrg = new();
    private ApplicationUser? _editingUser;

    // Credentials popup properties
    private bool _credentialsVisible;
    private string _createdMobile = "";
    private string _createdPassword = "";

    private bool _addCreditsVisible;
    private Organizer? _selectedOrgForCredits;
    private int _creditsToAdd = 5;
    private string _creditsAction = "Add";
    private string _creditsDescription = "Manual adjustment";
    private List<OrganizerCreditTransaction> _creditHistory = new();

    private bool _viewEventsVisible;
    private Organizer? _selectedOrgForEvents;
    private List<Event> _orgEvents = new();

    public class OrganizerVm
    {
        public Organizer Org { get; set; } = null!;
        public ApplicationUser? User { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsLoggedIn || Session.CurrentUser?.Role != UserRole.SuperAdmin)
        {
            Navigation.NavigateTo("/dashboard");
            return;
        }

        await LoadOrganizersAsync();
    }

    @inject IJSRuntime JSRuntime

    private async Task CopyMobile()
    {
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", _createdMobile);
        Snackbar.Add("Mobile number copied to clipboard!", Severity.Success);
    }

    private async Task CopyPassword()
    {
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", _createdPassword);
        Snackbar.Add("Temporary password copied to clipboard!", Severity.Success);
    }

    private async Task LoadOrganizersAsync()
    {
        _loading = true;
        try
        {
            using var scope = appServices.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<IApplicationDbContext>();
            var orgs = await db.Organizers.OrderBy(o => o.Name).ToListAsync();
            _organizersList.Clear();
            foreach (var org in orgs)
            {
                var user = await db.Users
                    .FirstOrDefaultAsync(u => u.Role == UserRole.Organizer && u.PhoneNumber == org.ContactNumber);
                    
                _organizersList.Add(new OrganizerVm { Org = org, User = user });
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load organizers: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void OpenAddOrganizerDialog()
    {
        _isEdit = false;
        _editingOrg = new Organizer { CreditsRemaining = 5 };
        _organizerDialogVisible = true;
    }

    private void OpenEditDialog(OrganizerVm vm)
    {
        _isEdit = true;
        _editingOrg = vm.Org;
        _editingUser = vm.User;
        _organizerDialogVisible = true;
    }

    private async Task SaveOrganizer()
    {
        if (string.IsNullOrWhiteSpace(_editingOrg.Name) || string.IsNullOrWhiteSpace(_editingOrg.ContactNumber))
        {
            Snackbar.Add("Name and Contact Number are required.", Severity.Warning);
            return;
        }

        try
        {
            if (_isEdit)
            {
                // Update Org Record
                var org = await DbContext.Organizers.FindAsync(_editingOrg.Id);
                if (org != null)
                {
                    org.Name = _editingOrg.Name;
                    var oldContact = org.ContactNumber;
                    org.ContactNumber = _editingOrg.ContactNumber;
                    
                    // Update user account details if exists
                    if (_editingUser != null)
                    {
                        _editingUser.FullName = _editingOrg.Name;
                        _editingUser.PhoneNumber = _editingOrg.ContactNumber;
                        _editingUser.UserName = _editingOrg.ContactNumber;
                        await UserManager.UpdateAsync(_editingUser);
                    }
                    
                    await DbContext.SaveChangesAsync(default);
                    Snackbar.Add("Organizer updated successfully.", Severity.Success);
                }
            }
            else
            {
                // Verify unique mobile number before adding
                var existingUser = await UserManager.FindByNameAsync(_editingOrg.ContactNumber);
                if (existingUser != null)
                {
                    Snackbar.Add("An account with this mobile number already exists.", Severity.Error);
                    return;
                }

                // Create Organizer Tenant Record
                _editingOrg.Id = Guid.NewGuid();
                _editingOrg.CreatedDate = DateTime.Now;
                _editingOrg.CreatedBy = Session.CurrentUser?.Id.ToString() ?? "System";

                DbContext.Organizers.Add(_editingOrg);

                // Create User Account with temporary credentials
                var tempPassword = "TempOrganizer123!";
                var user = new ApplicationUser
                {
                    Id = Guid.NewGuid(),
                    UserName = _editingOrg.ContactNumber,
                    PhoneNumber = _editingOrg.ContactNumber,
                    FullName = _editingOrg.Name,
                    Role = UserRole.Organizer,
                    Status = UserStatus.PendingActivation,
                    WalletBalance = 0.00m,
                    CreatedBy = Session.CurrentUser?.Id.ToString() ?? "System",
                    CreatedDate = DateTime.Now
                };

                var createResult = await UserManager.CreateAsync(user, tempPassword);
                if (createResult.Succeeded)
                {
                    await UserManager.AddToRoleAsync(user, UserRole.Organizer.ToString());
                    
                    // Initial Credit Transaction
                    var tx = new OrganizerCreditTransaction
                    {
                        Id = Guid.NewGuid(),
                        OrganizerId = _editingOrg.Id,
                        CreditsChanged = _editingOrg.CreditsRemaining,
                        Type = CreditTransactionType.Purchase,
                        Description = "Initial Credit Allocation",
                        Timestamp = DateTime.Now,
                        CreatedDate = DateTime.Now
                    };
                    DbContext.OrganizerCreditTransactions.Add(tx);

                    // Audit Log
                    var log = new ActivityLog
                    {
                        Id = Guid.NewGuid(),
                        UserId = user.Id,
                        Action = "Organizer Onboarded",
                        Description = $"Organizer {user.FullName} onboarded. Login username: {user.UserName}, Temp Password: {tempPassword}",
                        Timestamp = DateTime.Now,
                        CreatedDate = DateTime.Now
                    };
                    DbContext.ActivityLogs.Add(log);

                    await DbContext.SaveChangesAsync(default);
                    
                    _createdMobile = _editingOrg.ContactNumber;
                    _createdPassword = tempPassword;
                    _credentialsVisible = true;
                    
                    Snackbar.Add($"Organizer onboarded successfully!", Severity.Success);
                }
                else
                {
                    var errors = string.Join(", ", createResult.Errors.Select(e => e.Description));
                    throw new Exception($"Failed to create login account: {errors}");
                }
            }

            _organizerDialogVisible = false;
            await LoadOrganizersAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task OpenAddCreditsDialog(Organizer org, string action)
    {
        _selectedOrgForCredits = org;
        _creditsToAdd = 5;
        _creditsAction = action;
        _creditsDescription = action == "Add" ? "Manual adjustment" : "Manual deduction";
        using var scope = appServices.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<IApplicationDbContext>();
        _creditHistory = await db.OrganizerCreditTransactions
            .Where(t => t.OrganizerId == org.Id)
            .OrderByDescending(t => t.Timestamp)
            .ToListAsync();
        _addCreditsVisible = true;
    }

    private async Task SaveCreditsGrant()
    {
        if (_selectedOrgForCredits == null || _creditsToAdd <= 0 || string.IsNullOrWhiteSpace(_creditsDescription))
        {
            Snackbar.Add("Please enter a valid amount and description.", Severity.Warning);
            return;
        }

        try
        {
            using var scope = appServices.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<IApplicationDbContext>();
            var org = await db.Organizers.FindAsync(_selectedOrgForCredits.Id);
            if (org != null)
            {
                var change = _creditsAction == "Add" ? _creditsToAdd : -_creditsToAdd;
                if (org.CreditsRemaining + change < 0)
                {
                    Snackbar.Add("Deduction amount exceeds current credit balance.", Severity.Error);
                    return;
                }

                org.CreditsRemaining += change;
                
                var tx = new OrganizerCreditTransaction
                {
                    Id = Guid.NewGuid(),
                    OrganizerId = org.Id,
                    CreditsChanged = change,
                    Type = change >= 0 ? CreditTransactionType.Purchase : CreditTransactionType.Deduction,
                    Description = _creditsDescription,
                    Timestamp = DateTime.Now,
                    CreatedDate = DateTime.Now
                };
                db.OrganizerCreditTransactions.Add(tx);

                await db.SaveChangesAsync(default);
                Snackbar.Add($"Credits adjusted successfully by {change}.", Severity.Success);
                _addCreditsVisible = false;
                await LoadOrganizersAsync();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task ToggleSuspend(ApplicationUser user, bool suspend)
    {
        try
        {
            user.Status = suspend ? UserStatus.Suspended : UserStatus.Active;
            await UserManager.UpdateAsync(user);

            using var scope = appServices.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<IApplicationDbContext>();
            var log = new ActivityLog
            {
                Id = Guid.NewGuid(),
                UserId = user.Id,
                Action = suspend ? "Organizer Suspended" : "Organizer Activated",
                Description = $"Organizer {user.FullName} status set to {user.Status}.",
                Timestamp = DateTime.Now,
                CreatedDate = DateTime.Now
            };
            db.ActivityLogs.Add(log);
            await db.SaveChangesAsync(default);

            Snackbar.Add(suspend ? "Organizer account suspended." : "Organizer account activated.", Severity.Info);
            await LoadOrganizersAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task ResetPassword(ApplicationUser user)
    {
        try
        {
            var token = await UserManager.GeneratePasswordResetTokenAsync(user);
            var tempPassword = "TempOrgReset123!";
            var result = await UserManager.ResetPasswordAsync(user, token, tempPassword);
            if (result.Succeeded)
            {
                // Reset status to pending activation so they are forced to reset password on next login
                user.Status = UserStatus.PendingActivation;
                await UserManager.UpdateAsync(user);

                using var scope = appServices.CreateScope();
                var db = scope.ServiceProvider.GetRequiredService<IApplicationDbContext>();
                var log = new ActivityLog
                {
                    Id = Guid.NewGuid(),
                    UserId = user.Id,
                    Action = "Password Reset",
                    Description = $"Organizer password reset by Admin. Temp Password: {tempPassword}",
                    Timestamp = DateTime.Now,
                    CreatedDate = DateTime.Now
                };
                db.ActivityLogs.Add(log);
                await db.SaveChangesAsync(default);

                Snackbar.Add($"Password reset successfully. Temp Password: {tempPassword}", Severity.Success);
                await LoadOrganizersAsync();
            }
            else
            {
                var errors = string.Join(", ", result.Errors.Select(e => e.Description));
                throw new Exception(errors);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Password reset failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task ViewEvents(Organizer org)
    {
        _selectedOrgForEvents = org;
        using var scope = appServices.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<IApplicationDbContext>();
        _orgEvents = await db.Events
            .Where(e => e.OrganizerId == org.Id)
            .OrderByDescending(e => e.EventDate)
            .ToListAsync();
        _viewEventsVisible = true;
    }

    private async Task DeleteOrganizer(OrganizerVm vm)
    {
        try
        {
            using var scope = appServices.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<IApplicationDbContext>();
            var org = await db.Organizers.FindAsync(vm.Org.Id);
            if (org != null)
            {
                db.Organizers.Remove(org);
            }
            if (vm.User != null)
            {
                await UserManager.DeleteAsync(vm.User);
            }
            await db.SaveChangesAsync(default);
            Snackbar.Add("Organizer account deleted successfully.", Severity.Success);
            await LoadOrganizersAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Delete failed: {ex.Message}", Severity.Error);
        }
    }
}
